+  background: linear-gradient(180deg, rgba(8,14,22,0.92), rgba(8,14,22,0.66));
+  border-bottom:1px solid rgba(0,212,255,0.18);
+  backdrop-filter: blur(12px) saturate(1.2);
+  z-index:10;
+}
+.brand{display:flex;align-items:center;gap:12px}

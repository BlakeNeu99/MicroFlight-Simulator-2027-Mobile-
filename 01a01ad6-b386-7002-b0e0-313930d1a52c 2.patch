+    gl.uniform3f(p.uniforms.get('uSunDir')!, this.sunDir.x, this.sunDir.y, this.sunDir.z);
+    gl.uniform1f(p.uniforms.get('uTime')!, this.time);
+    gl.uniform1f(p.uniforms.get('uCoverage')!, coverage);

+:root{
+  --bg:#0b0f14;
+  --panel:#111820ee;
+  --panel-2:#16202b;
+  --accent:#00d4ff;
+  --accent-2:#ff3b30;
+  --text:#e6eef7;
+  --muted:#8a9bb0;
+  --success:#2ecc71;
+  --warn:#f1c40f;
+  --danger:#e74c3c;
+  --hud-glow: 0 0 18px rgba(0,212,255,0.45);
+}
+*{box-sizing:border-box}
+html,body{margin:0;padding:0;background:#02060a;color:var(--text);font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; overflow:hidden; overscroll-behavior:none; touch-action:none}
+#app{position:relative;width:100vw;height:100vh;overflow:hidden;background:radial-gradient(1200px 800px at 72% 18%, #1a2a3f 0%, #0b0f14 55%, #02060a 100%)}
+canvas#game{position:absolute;inset:0;width:100%;height:100%;display:block}

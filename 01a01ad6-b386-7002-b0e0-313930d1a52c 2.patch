+      const i0 = add([xLEroot, wingY+0.06, z0],[0,1,0],[0,0]);
+      const i1 = add([xTEroot, wingY+0.06, z0],[0,1,0],[1,0]);
+      const i2 = add([xLEtip, wingY+0.06, z1],[0,1,0],[0,1]);

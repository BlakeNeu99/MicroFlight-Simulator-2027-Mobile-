+.slim{height:6px;background:rgba(255,255,255,0.08);border-radius:999px;overflow:hidden}
+.slim i{display:block;height:100%;background:linear-gradient(90deg, #00d4ff, #2ecc71);width:68%}
+
+/* Responsive mobile */
+@media (max-width: 860px){
+  .hud-left{width:168px;top:58px}

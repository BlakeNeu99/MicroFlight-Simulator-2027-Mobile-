+      const i0=add([x0,0.1,z0],[0,0,1],[0,0]);
+      const i1=add([x1,0.1,z0],[0,0,1],[1,0]);
+      const i2=add([x0,0.1,z1],[0,0,1],[0,1]);
+      const i3=add([x1,0.1,z1],[0,0,1],[1,1]);
